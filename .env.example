# AgentIQ Environment Configuration
APP_NAME=AgentIQ
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Database Settings (Default: SQLite for immediate local execution, PostgreSQL compatible)
DATABASE_URL=sqlite:///./agentiq.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agentiq

# Security & Authentication
JWT_SECRET=agentiq-super-secret-jwt-key-batch08-cse-ds-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Official Google GenAI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Storage Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
